{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|shell_command|functions.shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/pre_tool_use_policy.py",
            "commandWindows": "py -3 ${PLUGIN_ROOT}\\hooks\\pre_tool_use_policy.py",
            "timeout": 10,
            "statusMessage": "Checking CompText Guard policy"
          }
        ]
      }
    ]
  }
}